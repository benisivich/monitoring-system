rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Personnel profile rules (ABAC & PII isolation)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Buoy live state (readable by any signed-in personnel, writable by authorized staff)
    match /buoys/{buoyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // LoRa packets telemetry stream
    match /packets/{packetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // History and audit trail
    match /history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Gateway station connectivity
    match /gateway/{gatewayId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
